.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/

# 运行时数据：数据库、产物、临时工作目录、密钥
# 用 .workerbee*/ 而不是 .workerbee/：后者匹配不到 .workerbee-demo/ 一类的
# 演示数据目录，而数据库恰好被下面的 *.db 规则挡住、产物文件（无扩展名）挡不住，
# 结果是「库没进去、产物进去了」这种半泄漏。
.workerbee*/
# 只忽略仓库根下的 data/。**必须带前导斜杠**：不带的话 gitignore 的匹配是
# 「任意层级」，`data/` 会连 `src/workerbee/data/`（源码包）一起吃掉——
# 结果是整个数据层从来没能提交，别人 clone 下来 import 就失败。
/data/
*.db
*.db-wal
*.db-shm

# 仓库内的临时比对产物，不属于发布内容
assets/logo-preview.*

# 前端
node_modules/
web/dist/

# PDF/DOCX 的抽取产物。文档本体（proposal、审计、需求清单、架构设计）要留在库里，
# 只排除这个中间目录，所以规则精确到 _txt/ 而不是整个 docs/。
docs/_txt/

# 内部交接文档。仓库是公开的，而这里记的是本机绝对路径、运行中的进程号、
# 开发数据目录的口令一类的运维细节——对仓库的读者没有价值，对本机却是信息泄露。
# 需要版本化时再单独 -f 加进来。
handover/
