{
  "name": "workerbee-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Workerbee Web 客户端：流程编辑、任务提交、实际执行图、审批与清理入口",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
